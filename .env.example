# Disabled until explicitly configured. Never commit real credentials.
SNOW_MODE=off
SNOW_DB=runtime/lite/statistics.db
SNOW_ORIGINS=https://xiaob.dev,https://snow.xiaob.dev
SNOW_READER_TOKEN=
SNOW_SERVER_TOKEN=
# Low-traffic default: 512 MiB state, 256 MiB RAM, 0.25 CPU. Existing volumes are never resized.
SNOW_BUDGET_BYTES=536870912
SNOW_COLLECTOR_MEMORY=256m
SNOW_COLLECTOR_CPUS=0.25
SNOW_ALLOWED_PATHS=/,/journal/,/projects/,/tools/,/gallery/,/now/,/about/,/updates/,/status/,/statistics/
SNOW_ALLOWED_CHARACTERS=
