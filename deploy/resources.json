{
  "owner": "Snow_Statistics",
  "version": 1,
  "online": {
    "compose_project": "snow-statistics-lite",
    "network": "snow-statistics-lite",
    "state_root": "/var/lib/snow-statistics",
    "systemd_service": "snow-statistics-lite.service",
    "state_quota_bytes": 2147483648,
    "loopback_port": 8100,
    "public_routes": ["/analytics/v1/events", "/analytics/public/v1/summary.json"],
    "private_route": "/analytics/private/v1/events"
  },
  "local": {
    "vm_root": "runtime/vmware",
    "vm_names": ["snow-control", "snow-compute", "snow-analysis"],
    "compose_projects": ["snow-lab-control", "snow-lab-compute", "snow-lab-analysis", "snow-lab-orchestration", "snow-lab-ha"],
    "airflow_gateway": {
      "host": "snow-control",
      "private_key_directory": "lab/secrets/airflow-ssh",
      "authorized_key_comment": "snow-statistics-airflow",
      "forced_command": "tools/airflow_gateway.py",
      "publisher_lock_and_packages": "runtime/publication",
      "metadata_volume": "snow-lab-orchestration_airflow"
    },
    "model_publication": {
      "host": "snow-control",
      "dag": "snow_models",
      "hdfs_root": "/snow/warehouse/model-runs/<attempt-id>/<kind>",
      "hive_database": "snow_synthetic",
      "hive_tables": ["ops_<attempt-id>_*", "behavior_<attempt-id>_*"],
      "accepted_packages": "runtime/publication/<attempt-id>.<kind>.json",
      "release_history": "runtime/publication/model-releases",
      "latest_pointer": "runtime/publication/models-latest.json",
      "synthetic_boundary_input": "/snow/ods/synthetic/behavior-fixture-v1",
      "synthetic_boundary_output": "/snow/warehouse/behavior-tests",
      "shutdown": "Pause snow_models and stop project services. Preserve accepted packages, Hive metadata, HDFS tables and release history; export the latest private aggregates for offline demonstration."
    },
    "incremental_ods": {
      "host": "snow-control",
      "single_writer_directory": "runtime/ods/<lane>",
      "consumer_group": "snow-ods-<lane>",
      "hdfs_root": "/snow/ods/synthetic/kafka/<lane>",
      "staging_root": "/snow/ods/synthetic/kafka/<lane>/_staging",
      "hdfs_operations": "/snow/warehouse/operations/<run-id>",
      "shutdown": "Stop commands without deleting journal, raw archives, HDFS batches or snapshots. Review pending and landed state before resuming."
    },
    "max_project_bytes": 64424509440,
    "min_host_free_bytes": 37580963840
  },
  "retirement": {
    "lite": "Stop local consumers and laboratory Compose projects; keep online collector and summary API unchanged.",
    "off": "Disable product adapters, drain accepted events, export aggregates, archive/remove public page, stop collector.",
    "delete": "Separate explicit export and reviewed resource-specific removal. No global prune; no automatic deletion on mode switch."
  }
}
